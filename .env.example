# Server-side Next.js rewrite target (or Cloud Function URL in production)
API_URL=http://localhost:3001

# Firebase Web SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mnis-egypt-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mnis-egypt-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mnis-egypt-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
