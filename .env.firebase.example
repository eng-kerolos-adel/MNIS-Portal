# Firebase Client Configuration for MNIS Staff Portal (Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mnis-egypt-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mnis-egypt-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mnis-egypt-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Use Firebase Auth & Firestore Local Emulators in development
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional App Check (reCAPTCHA Enterprise site key in production; debug token in dev)
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
